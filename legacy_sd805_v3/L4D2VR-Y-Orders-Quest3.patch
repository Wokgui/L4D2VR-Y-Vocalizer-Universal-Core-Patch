+void VR::ProcessOrdersMenuInput()
+{
+    if (!m_Game->m_EngineClient->IsInGame())
+    {
+        if (m_OrdersMenuOpen)
+        {
+            m_Game->ClientCmd_Unrestricted("-mouse_menu Orders");
+            m_OrdersMenuOpen = false;
+        }
+        return;
+    }
+
+    vr::InputDigitalActionData_t actionData = {};
+    const vr::EVRInputError result = m_Input->GetDigitalActionData(
+        m_OrdersMenu,
+        &actionData,
+        sizeof(actionData),
+        vr::k_ulInvalidInputValueHandle);
+
+    // SteamVR can temporarily make an action unavailable while an overlay is
+    // handling input. That is not a physical button release, so keep the menu
+    // state unchanged until an active press/release transition is reported.
+    if (result != vr::VRInputError_None || !actionData.bActive || !actionData.bChanged)
+        return;
+
+    if (actionData.bState && !m_OrdersMenuOpen)
+    {
+        m_Game->ClientCmd_Unrestricted("+mouse_menu Orders");
+        m_OrdersMenuOpen = true;
+    }
+    else if (!actionData.bState && m_OrdersMenuOpen)
+    {
+        m_Game->ClientCmd_Unrestricted("-mouse_menu Orders");
+        m_OrdersMenuOpen = false;
+    }
+}
