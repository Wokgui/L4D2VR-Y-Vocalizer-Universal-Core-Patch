+void VR::ProcessOrdersMenuInput()
+{
+    if (!m_Game->m_EngineClient->IsInGame())
+    {
+        if (m_OrdersMenuOpen)
+        {
+            m_Game->ClientCmd_Unrestricted("-mouse_menu");
+            m_OrdersMenuOpen = false;
+            m_OrdersMenuRawTracking = false;
+        }
+        return;
+    }
+
+    // The radial overlay can capture the SteamVR action before its falling
+    // edge reaches us. On Oculus Touch, Y is also exposed through the legacy
+    // ApplicationMenu bit, so use that physical state while the menu is open.
+    if (m_OrdersMenuOpen && m_OrdersMenuRawTracking)
+    {
+        bool yPressed = true;
+        if (GetOculusTouchYState(yPressed) && !yPressed)
+        {
+            m_Game->ClientCmd_Unrestricted("-mouse_menu");
+            m_OrdersMenuOpen = false;
+            m_OrdersMenuRawTracking = false;
+            return;
+        }
+    }
+
+    vr::InputDigitalActionData_t actionData = {};
+    const vr::EVRInputError result = m_Input->GetDigitalActionData(
+        m_OrdersMenu,
+        &actionData,
+        sizeof(actionData),
+        vr::k_ulInvalidInputValueHandle);
+
+    // An inactive action is not a physical release. When active, bState is the
+    // source of truth even if SteamVR lost bChanged during a map transition or
+    // while the radial overlay was interactive.
+    if (result != vr::VRInputError_None || !actionData.bActive)
+        return;
+
+    if (actionData.bState && !m_OrdersMenuOpen)
+    {
+        bool yPressed = false;
+        m_OrdersMenuRawTracking = GetOculusTouchYState(yPressed) && yPressed;
+        m_Game->ClientCmd_Unrestricted("+mouse_menu Orders");
+        m_OrdersMenuOpen = true;
+    }
+    else if (!actionData.bState && m_OrdersMenuOpen)
+    {
+        m_Game->ClientCmd_Unrestricted("-mouse_menu");
+        m_OrdersMenuOpen = false;
+        m_OrdersMenuRawTracking = false;
+    }
+}
+
+bool VR::GetOculusTouchYState(bool &stateOut)
+{
+    const vr::TrackedDeviceIndex_t leftControllerIndex =
+        m_System->GetTrackedDeviceIndexForControllerRole(vr::TrackedControllerRole_LeftHand);
+
+    if (leftControllerIndex == vr::k_unTrackedDeviceIndexInvalid)
+        return false;
+
+    vr::VRControllerState_t controllerState = {};
+    if (!m_System->GetControllerState(leftControllerIndex, &controllerState, sizeof(controllerState)))
+        return false;
+
+    stateOut = (controllerState.ulButtonPressed &
+                vr::ButtonMaskFromId(vr::k_EButton_ApplicationMenu)) != 0;
+    return true;
+}
